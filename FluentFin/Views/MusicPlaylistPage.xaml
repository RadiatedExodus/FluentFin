<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.MusicPlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctkl="using:CommunityToolkit.Labs.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Page"
    Margin="{StaticResource MediumLeftTopRightBottomMargin}"
    mc:Ignorable="d">

    <Page.Resources>
        <cc:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Spacing="28">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="220" Height="220">
                    <controls:LazyLoadedImage
                        BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(ViewModel.Playlist, jm:ImageType.Primary, 440), Mode=OneWay}"
                        EnableBlurHash="True"
                        ImageUri="{x:Bind c:BaseItemDtoConverters.GetImageUri(ViewModel.Playlist, jm:ImageType.Primary, 440), Mode=OneWay}"
                        Stretch="UniformToFill" />
                    <Button
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.PlayPlaylistCommand, Mode=OneWay}"
                        Content="{ui:FontIcon Glyph=&#xF5B0;, FontSize=24}"
                        CornerRadius="32"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Play playlist" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Playlist" />
                    <TextBlock
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.PlaylistName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxLines="3"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.OverviewText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.HasOverview), Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsNotLoading), Mode=OneWay}">
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind ViewModel.TrackCountText, Mode=OneWay}" />
                            <TextBlock
                                Style="{ThemeResource BodyTextBlockStyle}"
                                Text="{x:Bind c:Converters.TicksToTime2(ViewModel.TotalRunTimeTicks), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsLoading), Mode=OneWay}">
                            <ctkl:Shimmer Width="72" Height="18" />
                            <ctkl:Shimmer Width="56" Height="18" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Content="{ui:FontIcon Glyph=&#xE712;}"
                    CornerRadius="20"
                    Style="{ThemeResource BareButtonStyle}"
                    ToolTipService.ToolTip="Playlist actions"
                    Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.CanEditPlaylist), Mode=OneWay}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="RenamePlaylist_Click"
                                Icon="{ui:FontIcon Glyph=&#xE8AC;}"
                                Text="Rename" />
                            <MenuFlyoutItem
                                Click="DeletePlaylist_Click"
                                Icon="{ui:FontIcon Glyph=&#xE74D;}"
                                Text="Delete" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <ListView
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                SelectionMode="None"
                Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsNotLoading), Mode=OneWay}">
                <ListView.Header>
                    <Grid Padding="12,0,12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" />
                        <TextBlock Grid.Column="1" Text="Title" />
                        <TextBlock Grid.Column="2" Text="Artist" />
                        <TextBlock Grid.Column="3" Text="Album" />
                        <TextBlock Grid.Column="4" Text="Duration" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MusicAlbumTrackViewModel">
                        <Grid
                            Padding="12,8"
                            ColumnSpacing="12"
                            DoubleTapped="Track_DoubleTapped">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Command="{Binding ElementName=Page, Path=ViewModel.PlayTrackCommand}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:FontIcon Glyph=&#xF5B0;}"
                                        Text="Play" />
                                    <MenuFlyoutItem
                                        Command="{x:Bind root:App.Commands.PlayNextDtoCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind Dto, Mode=OneWay}"
                                        Icon="{ui:FontIcon Glyph=&#xE892;}"
                                        Text="Play next" />
                                    <MenuFlyoutItem
                                        Command="{x:Bind root:App.Commands.AddToQueueDtoCommand, Mode=OneWay}"
                                        CommandParameter="{x:Bind Dto, Mode=OneWay}"
                                        Icon="{ui:FontIcon Glyph=&#xE109;}"
                                        Text="Add to queue" />
                                    <MenuFlyoutItem
                                        Click="RemoveTrack_Click"
                                        Icon="{ui:FontIcon Glyph=&#xE74D;}"
                                        Tag="{Binding}"
                                        Text="Remove from playlist"
                                        Visibility="{Binding ElementName=Page, Path=ViewModel.CanEditPlaylist, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind DisplayNumberText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind Dto.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind ArtistsText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind c:Converters.BooleanToVisibility(HasNoArtistLinks), Mode=OneWay}" />
                            <ItemsRepeater
                                Grid.Column="2"
                                ItemsSource="{x:Bind ArtistLinks, Mode=OneWay}"
                                Visibility="{x:Bind c:Converters.BooleanToVisibility(HasArtistLinks), Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MusicArtistLinkViewModel">
                                        <HyperlinkButton
                                            Margin="0,-4,0,-4"
                                            Command="{x:Bind OpenCommand, Mode=OneWay}"
                                            Content="{x:Bind Name, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            MinWidth="0"
                                            Padding="0"
                                            Style="{StaticResource TextBlockButtonStyle}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Text="{x:Bind Dto.Album, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Text="{x:Bind c:Converters.TicksToTime2(Dto.RunTimeTicks), Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel
                Spacing="0"
                Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsLoading), Mode=OneWay}">
                <Grid Padding="12,0,12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <ctkl:Shimmer Width="20" Height="16" />
                    <ctkl:Shimmer Grid.Column="1" Width="48" Height="16" HorizontalAlignment="Left" />
                    <ctkl:Shimmer Grid.Column="2" Width="48" Height="16" HorizontalAlignment="Left" />
                    <ctkl:Shimmer Grid.Column="3" Width="48" Height="16" HorizontalAlignment="Left" />
                    <ctkl:Shimmer Grid.Column="4" Width="64" Height="16" HorizontalAlignment="Left" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind c:Converters.GetDummyItemSource(12)}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <ctkl:Shimmer Width="20" Height="18" />
                                <ctkl:Shimmer Grid.Column="1" Height="18" />
                                <ctkl:Shimmer Grid.Column="2" Height="18" />
                                <ctkl:Shimmer Grid.Column="3" Height="18" />
                                <ctkl:Shimmer Grid.Column="4" Width="64" Height="18" HorizontalAlignment="Left" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FluentFin.Views.MusicAlbumPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:ctkl="using:CommunityToolkit.Labs.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:Name="Page"
    Margin="{StaticResource MediumLeftTopRightBottomMargin}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Spacing="28">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="220" Height="220">
                    <controls:LazyLoadedImage
                        BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(ViewModel.Album, jm:ImageType.Primary, 440), Mode=OneWay}"
                        EnableBlurHash="True"
                        ImageUri="{x:Bind c:BaseItemDtoConverters.GetImageUri(ViewModel.Album, jm:ImageType.Primary, 440), Mode=OneWay}"
                        Stretch="UniformToFill" />
                    <Button
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.PlayAlbumCommand, Mode=OneWay}"
                        Content="{ui:FontIcon Glyph=&#xF5B0;, FontSize=24}"
                        CornerRadius="32"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Play album" />
                </Grid>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <TextBlock
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="Album" />
                    <TextBlock
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.AlbumName, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.ArtistsText, Mode=OneWay}"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.HasNoArtistLinks), Mode=OneWay}" />
                    <ItemsRepeater
                        ItemsSource="{x:Bind ViewModel.ArtistLinks, Mode=OneWay}"
                        Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.HasArtistLinks), Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:MusicArtistLinkViewModel">
                                <HyperlinkButton
                                    Margin="0,-4,0,-4"
                                    Command="{x:Bind OpenCommand, Mode=OneWay}"
                                    Content="{x:Bind Name, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    MinWidth="0"
                                    Padding="0"
                                    Style="{StaticResource TextBlockButtonStyle}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind ViewModel.YearText, Mode=OneWay}" />
                        <TextBlock
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="{x:Bind c:Converters.TicksToTime2(ViewModel.TotalRunTimeTicks), Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ListView
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="12,0,12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" />
                        <TextBlock Grid.Column="1" Text="Title" />
                        <TextBlock Grid.Column="2" Text="Artist" />
                        <TextBlock Grid.Column="3" Text="Duration" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MusicAlbumTrackViewModel">
                        <Grid
                            Padding="12,8"
                            ColumnSpacing="12"
                            DoubleTapped="Track_DoubleTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind Dto.IndexNumber, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind Dto.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="{x:Bind ArtistsText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind c:Converters.BooleanToVisibility(HasNoArtistLinks), Mode=OneWay}" />
                            <ItemsRepeater
                                Grid.Column="2"
                                ItemsSource="{x:Bind ArtistLinks, Mode=OneWay}"
                                Visibility="{x:Bind c:Converters.BooleanToVisibility(HasArtistLinks), Mode=OneWay}">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MusicArtistLinkViewModel">
                                        <HyperlinkButton
                                            Margin="0,-4,0,-4"
                                            Command="{x:Bind OpenCommand, Mode=OneWay}"
                                            Content="{x:Bind Name, Mode=OneWay}"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            MinWidth="0"
                                            Padding="0"
                                            Style="{StaticResource TextBlockButtonStyle}" />
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Horizontal" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Text="{x:Bind c:Converters.TicksToTime2(Dto.RunTimeTicks), Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ctkl:Shimmer
                Height="120"
                Visibility="{x:Bind c:Converters.BooleanToVisibility(ViewModel.IsLoading), Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.MusicAlbumCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:root="using:FluentFin"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:Name="Root">

    <UserControl.Resources>
        <SolidColorBrush
            x:Key="Black65O"
            Opacity="0.65"
            Color="Black" />
        <cc:EmptyStringToObjectConverter
            x:Key="EmptyStringVisibilityConverter"
            EmptyValue="Collapsed"
            NotEmptyValue="Visible" />
        <c:JellyfinTitleConverter x:Key="NameConverter" />
        <c:JellyfinSubtitleConverter x:Key="SubtitleConverter" />
        <c:JellyfinFlyoutConverter x:Key="FlyoutConverter" />
        <c:NullableBoolToValueOrDefaultConverter x:Key="NullableBoolToValueOrDefaultConverter" />
    </UserControl.Resources>

    <Grid
        Width="{x:Bind ArtworkSize, Mode=OneWay}"
        ContextFlyout="{x:Bind Model.Dto, Converter={StaticResource FlyoutConverter}, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Width="{x:Bind ArtworkSize, Mode=OneWay}"
            Height="{x:Bind ArtworkSize, Mode=OneWay}"
            CornerRadius="8"
            Tapped="Artwork_Tapped">
            <controls:LazyLoadedImage
                BlurHashImageSource="{x:Bind c:BaseItemDtoConverters.GetBlurHash(Model.Dto, jm:ImageType.Primary, ArtworkSize), Mode=OneWay}"
                EnableBlurHash="True"
                ImageSource="{x:Bind c:BaseItemDtoConverters.GetImage(Model.Dto, jm:ImageType.Primary, ArtworkSize), Mode=OneWay}" />

            <Button
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource Black65O}"
                BorderThickness="0"
                Command="{x:Bind root:App.Commands.PlayDtoCommand, Mode=OneWay}"
                CommandParameter="{x:Bind Model.Dto, Mode=OneWay}"
                Content="{ui:FontIcon Glyph=&#xF5B0;}"
                CornerRadius="24"
                Tapped="PlayButton_Tapped"
                Style="{ThemeResource BareButtonStyle}"
                ToolTipService.ToolTip="Play" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="2,8,2,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind Model.Dto, Converter={StaticResource NameConverter}, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />

            <TextBlock
                Grid.Row="1"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Model.Dto, Converter={StaticResource SubtitleConverter}, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text, Converter={StaticResource EmptyStringVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>

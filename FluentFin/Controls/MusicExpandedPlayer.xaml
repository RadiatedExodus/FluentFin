<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.MusicExpandedPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <LinearGradientBrush
            x:Key="MusicPresentationBackgroundBrush"
            StartPoint="0,0"
            EndPoint="1,1">
            <GradientStop Offset="0" Color="#25202E" />
            <GradientStop Offset="0.45" Color="#17191E" />
            <GradientStop Offset="1" Color="#101316" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid Padding="32" Background="{StaticResource MusicPresentationBackgroundBrush}">
        <StackPanel
            MaxWidth="720"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">
            <Button
                Width="360"
                Height="360"
                Padding="0"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.OpenAlbumCommand, Mode=OneWay}"
                Style="{ThemeResource BareButtonStyle}">
                <Image Source="{x:Bind ViewModel.Artwork, Mode=OneWay}" Stretch="UniformToFill" />
            </Button>

            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind ViewModel.ArtistText, Mode=OneWay}"
                    TextAlignment="Center" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.AlbumTitle, Mode=OneWay}"
                    TextAlignment="Center" />
            </StackPanel>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                <Slider
                    x:Name="ProgressSlider"
                    Grid.Column="1"
                    Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                    Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
            </Grid>

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="14">
                <Button Command="{x:Bind ViewModel.ToggleShuffleCommand, Mode=OneWay}" Content="{ui:FontIcon Glyph=&#xE8B1;, FontSize=20}" Style="{ThemeResource BareButtonStyle}" ToolTipService.ToolTip="Shuffle" />
                <Button Command="{x:Bind ViewModel.PreviousCommand, Mode=OneWay}" Content="{ui:FontIcon Glyph=&#xE892;, FontSize=20}" Style="{ThemeResource BareButtonStyle}" ToolTipService.ToolTip="Previous" />
                <Button
                    Width="64"
                    Height="64"
                    Command="{x:Bind ViewModel.TogglePlayPauseCommand, Mode=OneWay}"
                    CornerRadius="32"
                    Style="{ThemeResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Play/Pause">
                    <Grid Width="28" Height="28">
                        <ProgressRing
                            Width="24"
                            Height="24"
                            Foreground="Black"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
                        <FontIcon
                            FontSize="24"
                            Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.PlayPauseIconVisibility, Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button Command="{x:Bind ViewModel.StopCommand, Mode=OneWay}" Content="{ui:SymbolIcon Symbol=Stop}" Style="{ThemeResource BareButtonStyle}" ToolTipService.ToolTip="Stop" />
                <Button Command="{x:Bind ViewModel.NextCommand, Mode=OneWay}" Content="{ui:FontIcon Glyph=&#xE893;, FontSize=20}" Style="{ThemeResource BareButtonStyle}" ToolTipService.ToolTip="Next" />
                <Button Command="{x:Bind ViewModel.CycleRepeatModeCommand, Mode=OneWay}" Style="{ThemeResource BareButtonStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.RepeatToolTip, Mode=OneWay}">
                    <FontIcon FontSize="20" Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" />
                </Button>
                <Button Command="{x:Bind ViewModel.OpenQueueCommand, Mode=OneWay}" Content="{ui:FontIcon Glyph=&#xE8FD;, FontSize=20}" Style="{ThemeResource BareButtonStyle}" ToolTipService.ToolTip="Queue" />
            </StackPanel>

            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon VerticalAlignment="Center" Glyph="&#xE767;" />
                <Slider
                    x:Name="VolumeSlider"
                    Width="220"
                    Maximum="100"
                    Value="{x:Bind ViewModel.VolumePercentValue, Mode=OneWay}" />
                <NumberBox
                    x:Name="VolumeNumberBox"
                    Width="80"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind ViewModel.VolumePercentValue, Mode=OneWay}"
                    ValueChanged="VolumeNumberBox_ValueChanged" />
                <TextBlock VerticalAlignment="Center" Text="%" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

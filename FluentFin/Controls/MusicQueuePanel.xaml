<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.MusicQueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localvm="using:FluentFin.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <cc:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <LinearGradientBrush
            x:Key="MusicPresentationBackgroundBrush"
            StartPoint="0,0"
            EndPoint="1,1">
            <GradientStop Offset="0" Color="#25202E" />
            <GradientStop Offset="0.45" Color="#17191E" />
            <GradientStop Offset="1" Color="#101316" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid
        Padding="32,24,32,120"
        Background="{StaticResource MusicPresentationBackgroundBrush}"
        RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Style="{ThemeResource TitleTextBlockStyle}"
            Text="Queue" />

        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.QueueItems, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="localvm:MusicQueueItemViewModel">
                    <Grid
                        Padding="12,9"
                        ColumnSpacing="12"
                        DoubleTapped="QueueItem_DoubleTapped"
                        RightTapped="QueueItem_RightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE768;"
                            Visibility="{x:Bind IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                Style="{ThemeResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind AlbumTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ArtistText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DurationText, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.MusicLyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:localvm="using:FluentFin.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    mc:Ignorable="d">

    <UserControl.Resources>
        <LinearGradientBrush
            x:Key="MusicPresentationBackgroundBrush"
            StartPoint="0,0"
            EndPoint="1,1">
            <GradientStop Offset="0" Color="#25202E" />
            <GradientStop Offset="0.45" Color="#17191E" />
            <GradientStop Offset="1" Color="#101316" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid
        Padding="48,34,48,120"
        Background="{StaticResource MusicPresentationBackgroundBrush}"
        RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="5">
            <TextBlock
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.ArtistText, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid Grid.Row="1">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="18"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                <ProgressRing
                    Width="42"
                    Height="42"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Loading lyrics" />
            </StackPanel>

            <StackPanel
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="No lyrics found" />
            </StackPanel>

            <ListView
                x:Name="LyricsList"
                MaxWidth="900"
                HorizontalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                PointerPressed="LyricsList_PointerPressed"
                SelectionMode="None"
                Visibility="{x:Bind ViewModel.LyricsVisibility, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="localvm:LyricsLineViewModel">
                        <TextBlock
                            Padding="0,10"
                            FontSize="{x:Bind FontSize, Mode=OneWay}"
                            Foreground="{x:Bind Foreground, Mode=OneWay}"
                            Opacity="{x:Bind Opacity, Mode=OneWay}"
                            Text="{x:Bind Text}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>

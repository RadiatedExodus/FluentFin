<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FluentFin.Controls.MusicAlbumCategoryRail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FluentFin.Converters"
    xmlns:controls="using:FluentFin.Controls"
    xmlns:jm="using:Jellyfin.Sdk.Generated.Models"
    xmlns:vm="using:FluentFin.Core.ViewModels"
    x:Name="Root">

    <StackPanel Spacing="12">
        <Button
            Padding="0"
            HorizontalAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind HeaderCommand, Mode=OneWay}"
            Style="{ThemeResource BareButtonStyle}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="{x:Bind Title, Mode=OneWay}" />
                <FontIcon
                    FontSize="14"
                    Glyph="&#xE974;" />
            </StackPanel>
        </Button>

        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <ItemsRepeater ItemsSource="{x:Bind Albums, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:BaseItemViewModel">
                        <ItemContainer
                            Width="190"
                            Margin="0,0,12,0"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Style="{StaticResource BareItemContainerStyle}">
                            <controls:MusicAlbumCard
                                ArtworkSize="190"
                                JellyfinClient="{Binding ElementName=Root, Path=JellyfinClient}"
                                Model="{x:Bind}" />
                        </ItemContainer>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
    </StackPanel>
</UserControl>

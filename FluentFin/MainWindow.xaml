<windowex:WindowEx
    x:Class="FluentFin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:core="using:FluentFin.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FluentFin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:FluentFin.Views"
    xmlns:windowex="using:WinUIEx"
    Title="FluentFin"
    MinWidth="500"
    MinHeight="500"
    PersistenceId="MainWindow"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <views:TitleBarControl Grid.Row="0" />

        <Frame x:Name="RootFrame" Grid.Row="1" />

        <ContentControl
            x:Name="PlaybackPresenter"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Canvas.ZIndex="10"
            Visibility="Collapsed" />

        <ContentControl
            x:Name="MusicOverlayPresenter"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Canvas.ZIndex="8"
            Visibility="Collapsed">
            <ContentControl.RenderTransform>
                <CompositeTransform x:Name="MusicOverlayTransform" ScaleX="0.96" ScaleY="0.96" />
            </ContentControl.RenderTransform>
        </ContentControl>

        <ContentControl
            x:Name="MusicMiniPlayerPresenter"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Opacity="0"
            VerticalAlignment="Bottom"
            VerticalContentAlignment="Stretch"
            Canvas.ZIndex="9"
            Visibility="Collapsed">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="MusicMiniPlayerTransform" Y="96" />
            </ContentControl.RenderTransform>
        </ContentControl>

    </Grid>

</windowex:WindowEx>
